<?xml version="1.0" encoding="UTF-8" standalone="yes"?> 
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity processorArchitecture="*" version="5.1.0.0" type="win32" name="fxfile.exe"/>
  <description>fxfile</description>
  <!--
    FxFile stores its portable configuration beside the executable and does
    not require administrative privileges for normal operation.  Declaring
    the execution level prevents Windows Program Compatibility Assistant from
    treating this legacy executable as an elevation candidate and relaunching
    it before the first frame is created.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" publicKeyToken="6595b64144ccf1df" language="*" processorArchitecture="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
